{
  "name": "agentweb",
  "version": "0.3.0",
  "description": "Headless web rendering for AI agents — structured JSON output, smart SPA detection, SQLite cache, interactive sessions",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./skill": "./skill.js",
    "./renderer": "./prototype/smart-renderer.js",
    "./interactive": "./prototype/interactive.js",
    "./cache": "./prototype/cache.js",
    "./diff-tracker": "./prototype/diff-tracker.js",
    "./playwright-diff": "./prototype/playwright-diff.js",
    "./watch-server": "./prototype/watch-server.js",
    "./playwright-watch-server": "./prototype/playwright-watch-server.js"
  },
  "bin": {
    "agentweb": "./prototype/cli.js"
  },
  "scripts": {
    "test": "cd prototype && node test.js",
    "test:cache": "cd prototype && node test-cache.js",
    "test:interactive": "cd prototype && node test-interactive.js --headed=false",
    "test:smart": "cd prototype && node test-smart-renderer.js",
    "test:diff": "node prototype/test-diff-tracker.js",
    "test:watch-server": "node prototype/test-watch-server.js",
    "test:integration": "node prototype/test-integration-pipeline.js",
    "test:playwright-diff": "node prototype/test-playwright-diff.js",
    "test:playwright-watch-server": "node prototype/test-playwright-watch-server.js",
    "test:all": "npm test && npm run test:cache && npm run test:diff && npm run test:playwright-diff && npm run test:watch-server && npm run test:playwright-watch-server && npm run test:integration",
    "render": "node prototype/cli.js",
    "watch-server": "node prototype/watch-server.js",
    "playwright-watch-server": "node prototype/playwright-watch-server.js",
    "benchmark": "node prototype/benchmark.js",
    "install-browsers": "cd prototype && npx playwright install chromium"
  },
  "files": [
    "index.js",
    "skill.js",
    "prototype/cli.js",
    "prototype/renderer.js",
    "prototype/lite-renderer.js",
    "prototype/smart-renderer.js",
    "prototype/interactive.js",
    "prototype/cache.js",
    "prototype/semantic-chunks.js",
    "prototype/diff-tracker.js",
    "prototype/playwright-diff.js",
    "prototype/watch-server.js",
    "prototype/test-integration-pipeline.js",
    "README.md",
    "SKILL.md"
  ],
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "optionalDependencies": {},
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "headless",
    "browser",
    "ai",
    "agent",
    "web",
    "playwright",
    "scraping",
    "rendering",
    "agentweb",
    "openClaw",
    "llm"
  ],
  "author": "Clark (https://github.com/clark235)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clark235/agentweb.git"
  },
  "homepage": "https://github.com/clark235/agentweb#readme",
  "bugs": {
    "url": "https://github.com/clark235/agentweb/issues"
  }
}
